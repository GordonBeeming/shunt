# shunt base guest image: Docker-in-guest (proven dind base) + .NET 10 SDK.
# Each siding runs one of these as an Apple `container` guest; Aspire's AppHost
# runs inside and brings up its dependency containers via the in-guest dockerd.
FROM docker:dind

# .NET 10 SDK on Alpine (musl). The runtime deps are the documented set Microsoft
# lists for Alpine; git is here for any restore/source-control needs inside the guest.
RUN apk add --no-cache \
        bash curl git tzdata \
        icu-libs krb5-libs libgcc libintl libssl3 libstdc++ zlib \
 && curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
 && bash /tmp/dotnet-install.sh --channel 10.0 --install-dir /usr/share/dotnet \
 && ln -sf /usr/share/dotnet/dotnet /usr/local/bin/dotnet \
 && rm -f /tmp/dotnet-install.sh

ENV DOTNET_ROOT=/usr/share/dotnet \
    PATH=/usr/share/dotnet:/usr/local/bin:/usr/bin:/bin \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1

COPY shunt-entrypoint.sh /usr/local/bin/shunt-entrypoint.sh
RUN chmod +x /usr/local/bin/shunt-entrypoint.sh

# Entrypoint starts dockerd in the background, waits for the socket, then execs
# whatever command shunt passes (the AppHost launch).
ENTRYPOINT ["/usr/local/bin/shunt-entrypoint.sh"]
